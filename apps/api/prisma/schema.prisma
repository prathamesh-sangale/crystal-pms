// ReeferReady PMS — container readiness pipeline
//
// SQLite so the whole stack runs from `npm run setup` with no infrastructure.
// Every column type used here exists in PostgreSQL too, so moving to Postgres
// is a provider swap plus a migration — no model changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Someone who signs in. Role decides what they may change.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  /// manager | supervisor | technician | viewer
  role         String  @default("viewer")
  passwordHash String
  depotId      String?
  depot        Depot?  @relation(fields: [depotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([depotId])
}

/// A yard. Exactly one is the home depot the signed-in manager works from.
model Depot {
  id       String  @id @default(cuid())
  name     String  @unique
  isHome   Boolean @default(false)
  /// Free-text location shown under the depot name.
  location String  @default("")

  containers Container[]
  offLease   OffLeaseUnit[]
  users      User[]
}

/// A technician, and the named person who covers for them.
model Technician {
  id       String  @id @default(cuid())
  name     String  @unique
  trade    String  @default("")
  active   Boolean @default(true)
  backupId String?

  backup    Technician?  @relation("Cover", fields: [backupId], references: [id], onDelete: SetNull)
  coversFor Technician[] @relation("Cover")

  containers Container[]

  @@index([backupId])
}

/// A container in the readiness pipeline.
model Container {
  /// The ISO 6346 unit number, e.g. `RFCU 445 129-8`. It is the natural key.
  id              String  @id
  size            String
  /// standard | double | anteroom
  type            String
  /// internal | external — only ever set for an anteroom unit
  anteroomVariant String?
  customer        String
  /// Standard | High | Urgent
  priority        String  @default("Standard")
  notes           String  @default("")

  depotId      String
  depot        Depot      @relation(fields: [depotId], references: [id], onDelete: Restrict)
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Restrict)

  /// Current stage id, e.g. `mechanical`.
  stage        String
  received     DateTime
  /// When it entered the current stage — the clock the day budget runs against.
  stageEntered DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks  ContainerTask[]
  events ContainerEvent[]

  @@index([depotId])
  @@index([technicianId])
  @@index([stage])
}

/// One checklist line on one container. Snapshotted from the task template at
/// registration, so editing the library never rewrites work already signed off.
model ContainerTask {
  id          String    @id @default(cuid())
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  /// Template key, e.g. `mechanical.07`.
  key     String
  stage   String
  label   String
  hrs     Float
  /// JSON array of container types when the task is variant-only, else null.
  onlyFor String?

  done   Boolean   @default(false)
  doneAt DateTime?
  doneBy String?

  @@unique([containerId, key])
  @@index([containerId, stage])
}

/// Append-only audit trail. Nothing in the pipeline changes without a line here.
model ContainerEvent {
  id          String    @id @default(cuid())
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  at      DateTime @default(now())
  /// registered | task-done | task-undone | stage-advanced | updated | removed
  kind    String
  summary String
  actor   String

  @@index([containerId, at])
}

/// Redelivered by a customer, not yet gated in. Lets the depot plan repair
/// capacity before the unit physically arrives.
model OffLeaseUnit {
  id       String @id
  customer String
  size     String
  type     String
  expected DateTime
  depotId  String
  depot    Depot  @relation(fields: [depotId], references: [id], onDelete: Restrict)
  /// IICL condition grade A–D.
  grade    String
  notes    String @default("")

  @@index([depotId])
}

/// A customer order waiting to be matched against inventory.
model CustomerOrder {
  id          String   @id
  customer    String
  size        String
  type        String
  qty         Int
  needBy      DateTime
  requirement String

  createdAt DateTime @default(now())

  @@map("customer_order")
}
