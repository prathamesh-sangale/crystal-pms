# Copy to .env before running the API.

# Change this. Any long random string; tokens signed with the old value stop working.
JWT_SECRET="dev-only-secret-change-me-in-any-real-deployment"

PORT=4000
# Origin the web app is served from, for CORS.
WEB_ORIGIN="http://localhost:5173"

# Supabase — the only database this app has. Required.
# From your Supabase project: Settings -> API.
# Only the service_role key is used — apps/api is the only Supabase caller,
# nothing talks to Supabase directly from the browser, so the anon key isn't
# needed here.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional. Only needed for a serverless deployment (e.g. Vercel), where
# there's no local filesystem to read credentials/google-service-account.json
# from — paste that file's full JSON contents here as one line. Leave unset
# for local dev; the file is used instead. See src/googleAuth.ts.
GOOGLE_SERVICE_ACCOUNT_JSON=
